root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{html,css,mts,ts,js,vue,yml,yaml,less,json}]
indent_size = 2

[composer.json]
indent_size = 4
